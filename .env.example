# Copy this file to .env and paste your keys. .env is gitignored.
# Any one source is enough. Several together give tribes mixed minds.
# No source at all: tribes play on the ordinary utility rules.

# --- paid ---------------------------------------------------------------
# Get a DeepSeek key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# Get an OpenAI key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- any OpenAI-compatible endpoint (free tiers, local models) ------------
# Uncomment ONE block. Model names and limits change: check the provider.
#
# Groq (free key at https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=
#
# Google Gemini (free key at https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=
#
# OpenRouter free models (key at https://openrouter.ai/keys; pick a ":free" model)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_API_KEY=
#
# Ollama on this machine (no key): `ollama pull qwen2.5:3b` first
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:3b
#
# Offline rule-based minds (no network, no cost) for development
# LLM_BASE_URL=mock
#
# Optional: display name, and calls per minute for all minds together.
# Free tiers cap requests per minute AND per day; keep this well under both.
# LLM_LABEL=Groq Llama
# LLM_MAX_CALLS_PER_MINUTE=5
